{
  "name": "ytopml",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "version": "1.3.0",
  "author": "Andrew Shell <andrew@andrewshell.org>",
  "homepage": "https://github.com/geekitycom/ytopml",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekitycom/ytopml.git"
  },
  "scripts": {
    "start": "nodemon app/server.js",
    "debug": "LOG_LEVEL=debug nodemon app/server.js",
    "css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "docker-push": "node build-docker.js",
    "test": "LOG_LEVEL=silent node --test",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "google-auth-library": "^10.5.0",
    "googleapis": "^169.0.0",
    "hono": "^4.6.16",
    "hono-sessions": "^0.8.0",
    "nunjucks": "^3.2.4",
    "winston": "^3.17.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/cli": "^4.1.18",
    "husky": "^9.1.7",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.1.18"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*"
    ],
    "ext": "js,njk"
  },
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
