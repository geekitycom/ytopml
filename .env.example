GOOGLE_CLIENT_ID="get from google"
GOOGLE_CLIENT_SECRET="get from google"
COOKIE_SECRET="generate a random string" # openssl rand -base64 32
OIDC_ISSUER_BASE_URL="http://localhost:3000"
PORT=3000

# rssCloud: advertise a cloud server in the OPML and ping it when a list changes.
# Automatically inactive when OIDC_ISSUER_BASE_URL is localhost, since the cloud
# server has to be able to fetch the OPML to notify subscribers.
RSSCLOUD_ENABLED=true
RSSCLOUD_SERVER="https://rpc.rsscloud.io"